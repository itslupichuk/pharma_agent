# ── RXTERM configuration ──────────────────────────────────────────────
# Optional: Claude writes the trade theses when this is set.
# Without it, RXTERM uses its built-in rules-based analyst writer.
ANTHROPIC_API_KEY=
RXTERM_MODEL=claude-opus-5-5

# Morning brief e-mail (Gmail: create an App Password at
# https://myaccount.google.com/apppasswords — requires 2-Step Verification)
RXTERM_EMAIL_TO=itslupichuk@gmail.com
RXTERM_EMAIL_FROM=itslupichuk@gmail.com
RXTERM_SMTP_HOST=smtp.gmail.com
RXTERM_SMTP_PORT=587
RXTERM_SMTP_USER=itslupichuk@gmail.com
RXTERM_SMTP_PASSWORD=

# Display timezone for the terminal and brief
RXTERM_TZ=America/New_York

# Set to 1 to run fully offline on synthetic data (demo / screenshots)
RXTERM_DEMO=0

# Where RXTERM keeps its cache, watchlist and catalyst overrides
# RXTERM_HOME=~/.rxterm
